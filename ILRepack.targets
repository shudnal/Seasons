<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<PropertyGroup>
		<ThunderstorePackageName>Seasons</ThunderstorePackageName>
		<ThunderstorePackageDir>$(MSBuildProjectDirectory)\package\thunderstore\$(ThunderstorePackageName)\</ThunderstorePackageDir>
		<ThunderstoreZipPath>$(MSBuildProjectDirectory)\package\thunderstore\$(ThunderstorePackageName).zip</ThunderstoreZipPath>

		<BuildThunderstorePackageOnBuild Condition="'$(BuildThunderstorePackageOnBuild)' == ''">true</BuildThunderstorePackageOnBuild>
		<CopyToR2ModManOnBuild Condition="'$(CopyToR2ModManOnBuild)' == ''">true</CopyToR2ModManOnBuild>

		<R2ModManPluginDirectory Condition="'$(R2ModManPluginDirectory)' == ''">D:\r2modman\Valheim\profiles\beta\BepInEx\plugins\shudnal-$(ThunderstorePackageName)\</R2ModManPluginDirectory>
	</PropertyGroup>

	<Target Name="UpdateTranslations" BeforeTargets="BeforeBuild">
		<Exec Command="powershell -ExecutionPolicy Bypass -NoProfile -File &quot;$(MSBuildProjectDirectory)\UpdateTranslations.ps1&quot;" />
		<Message Text="Updated embedded translations before build." Importance="High" />
	</Target>

	<!--
    Run post-build operations in an explicit order:
    1. Package the plugin DLL for Thunderstore.
    2. Copy the plugin DLL to the r2modman profile.
  -->
	<Target
	  Name="BuildSeasonsArtifacts"
	  AfterTargets="Build"
	  DependsOnTargets="BuildSeasonsThunderstorePackage;CopySeasonsToR2ModMan"
	  Condition="'$(DesignTimeBuild)' != 'true'" />

	<Target
	  Name="BuildSeasonsThunderstorePackage"
	  Condition="'$(BuildThunderstorePackageOnBuild)' == 'true'">

		<PropertyGroup>
			<_SeasonsPackageAssembly Condition="'$(SeasonsPackageAssembly)' != ''">$(SeasonsPackageAssembly)</_SeasonsPackageAssembly>
			<_SeasonsPackageAssembly Condition="'$(_SeasonsPackageAssembly)' == ''">$(TargetPath)</_SeasonsPackageAssembly>
			<_SeasonsEnglishLocalization>$(MSBuildProjectDirectory)\Translations\English.json</_SeasonsEnglishLocalization>
		</PropertyGroup>

		<Error Condition="!Exists('$(_SeasonsPackageAssembly)')" Text="Plugin assembly was not found: $(_SeasonsPackageAssembly)" />
		<Error Condition="!Exists('$(_SeasonsEnglishLocalization)')" Text="English localization was not found: $(_SeasonsEnglishLocalization)" />
		<Error Condition="!Exists('$(ThunderstorePackageDir)manifest.json')" Text="Thunderstore manifest was not found: $(ThunderstorePackageDir)manifest.json" />
		<Error Condition="!Exists('$(ThunderstorePackageDir)icon.png')" Text="Thunderstore icon was not found: $(ThunderstorePackageDir)icon.png" />
		<Error Condition="!Exists('$(ThunderstorePackageDir)README.md')" Text="Thunderstore README was not found: $(ThunderstorePackageDir)README.md" />
		<Error Condition="!Exists('$(ThunderstorePackageDir)CHANGELOG.md')" Text="Thunderstore changelog was not found: $(ThunderstorePackageDir)CHANGELOG.md" />
		<Error Condition="!Exists('$(MSBuildProjectDirectory)\UpdateThunderstoreManifest.ps1')" Text="UpdateThunderstoreManifest.ps1 was not found." />

		<GetAssemblyIdentity AssemblyFiles="$(_SeasonsPackageAssembly)">
			<Output TaskParameter="Assemblies" ItemName="_SeasonsAssemblyIdentity" />
		</GetAssemblyIdentity>

		<PropertyGroup>
			<PackageVersion>%(_SeasonsAssemblyIdentity.Version)</PackageVersion>
		</PropertyGroup>

		<Error Condition="'$(PackageVersion)' == ''" Text="Package version was not resolved from $(_SeasonsPackageAssembly)." />

		<MakeDir Directories="$(ThunderstorePackageDir)" />

		<Copy
		  SourceFiles="$(ThunderstorePackageDir)README.md"
		  DestinationFiles="$(MSBuildProjectDirectory)\README.md"
		  SkipUnchangedFiles="true" />

		<Copy
		  SourceFiles="$(_SeasonsPackageAssembly)"
		  DestinationFiles="$(ThunderstorePackageDir)$(ThunderstorePackageName).dll"
		  SkipUnchangedFiles="true" />

		<Copy
		  SourceFiles="$(_SeasonsEnglishLocalization)"
		  DestinationFiles="$(ThunderstorePackageDir)$(ThunderstorePackageName).English.json"
		  SkipUnchangedFiles="true" />

		<Exec
		  Command="powershell -ExecutionPolicy Bypass -NoProfile -File &quot;$(MSBuildProjectDirectory)\UpdateThunderstoreManifest.ps1&quot; -ManifestPath &quot;$(ThunderstorePackageDir)manifest.json&quot; -Version &quot;$(PackageVersion)&quot;" />

		<ZipDirectory
		  SourceDirectory="$(ThunderstorePackageDir)"
		  DestinationFile="$(ThunderstoreZipPath)"
		  Overwrite="true" />

		<Message Text="Detected package version from DLL: $(PackageVersion)" Importance="High" />
		<Message Text="Thunderstore package directory updated: $(ThunderstorePackageDir)" Importance="High" />
		<Message Text="Thunderstore archive created: $(ThunderstoreZipPath)" Importance="High" />
	</Target>

	<Target
	  Name="CopySeasonsToR2ModMan"
	  Condition="'$(CopyToR2ModManOnBuild)' == 'true'">

		<PropertyGroup>
			<_SeasonsR2ModManAssembly Condition="'$(SeasonsPackageAssembly)' != ''">$(SeasonsPackageAssembly)</_SeasonsR2ModManAssembly>
			<_SeasonsR2ModManAssembly Condition="'$(_SeasonsR2ModManAssembly)' == ''">$(TargetPath)</_SeasonsR2ModManAssembly>
		</PropertyGroup>

		<Error Condition="!Exists('$(_SeasonsR2ModManAssembly)')" Text="Plugin DLL was not found: $(_SeasonsR2ModManAssembly)" />

		<MakeDir Directories="$(R2ModManPluginDirectory)" />
		<Copy
		  SourceFiles="$(_SeasonsR2ModManAssembly)"
		  DestinationFiles="$(R2ModManPluginDirectory)$(ThunderstorePackageName).dll"
		  SkipUnchangedFiles="true" />

		<Message Text="Copied $(ThunderstorePackageName).dll to r2modman profile: $(R2ModManPluginDirectory)" Importance="High" />
	</Target>


</Project>
